# config/.env.example
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_API_URL=https://api.telegram.org/
LOG_LEVEL=info
SECRETARY_DATA_DIR=./data
SECRETARY_TIMEOUT_MINUTES=45
SECRETARY_WORK_START=09:00
SECRETARY_WORK_END=18:00
SECRETARY_LUNCH_START=13:00
SECRETARY_LUNCH_END=14:00
SECRETARY_WORK_DAYS=monday,tuesday,wednesday,thursday,friday
